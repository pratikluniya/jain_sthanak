# Copy this file to .env and fill in the blanks. Never commit .env.
# On the server, the same file lives at /opt/jainsangh/.env (see docs/SERVER-SETUP.md).

# ---------- Database ----------
# On the server the database runs in Docker next to the app. docker-compose.yml builds the
# DATABASE_URL from this password, so on the server you only set POSTGRES_PASSWORD (letters and digits only).
POSTGRES_PASSWORD="generate: openssl rand -hex 24"
# Local development only (npm run dev):
# DATABASE_URL="postgresql://jainsangh:devpass@localhost:5432/jainsangh"

# ---------- Web address ----------
# The subdomain pointed at the server. Caddy gets a free HTTPS certificate for it automatically.
APP_DOMAIN="jainsthanak.techshree.com"

# ---------- File storage (DigitalOcean Spaces, S3-compatible) ----------
# "s3" in production, "local" for development (files go to ./uploads)
STORAGE_DRIVER="s3"
# The Space name:
S3_BUCKET=""
S3_ENDPOINT="https://blr1.digitaloceanspaces.com"
# DigitalOcean's docs say to use "us-east-1" here; the endpoint above sets the real location (Bangalore).
S3_REGION="us-east-1"
# DigitalOcean > API > Spaces Keys > Generate New Key (limit it to this one Space)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---------- Secrets: generate once, keep a safe copy outside the server ----------
AUTH_SECRET="generate: openssl rand -base64 36"
# AADHAAR_ENC_KEY must NEVER change after Aadhaar numbers are saved, or they cannot be read again.
AADHAAR_ENC_KEY="generate: openssl rand -hex 32"

# ---------- Reading forms with AI (optional, for go-live) ----------
# Leave empty until the Sangh starts uploading forms in the app. console.anthropic.com > API Keys
ANTHROPIC_API_KEY=""
# [Unverified] confirm the current model id in the Anthropic console before go-live
CLAUDE_MODEL="claude-sonnet-4-5"
